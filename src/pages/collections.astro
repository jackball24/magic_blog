---
import Icon from "@components/common/Icon.astro";
import PageTitle from "@/components/common/PageTitle.astro";
import { collectionsApiConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/collections.css";

if (!siteConfig.pages.collections) {
	return Astro.redirect("/404/");
}

const title = collectionsApiConfig.title || i18n(I18nKey.collections);
const description =
	collectionsApiConfig.description || i18n(I18nKey.collectionsDescription);

// 按 category 分组，过滤掉禁用的项和空分组
const enabledGroups = collectionsApiConfig.apis
	.map((group) => ({
		category: group.category,
		items: group.items.filter((api) => api.enabled),
	}))
	.filter((group) => group.items.length > 0);

// 从分组顺序自动提取分类
const categories = enabledGroups.map((group) => group.category);

// 计算每个分类的数量
const categoryCounts: Record<string, number> = {};
for (const group of enabledGroups) {
	categoryCounts[group.category] = group.items.length;
}

const enabledApisCount = enabledGroups.reduce(
	(sum, group) => sum + group.items.length,
	0,
);
---

<MainGridLayout title={title} description={description} hasOwnH1={true}>

  <div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <!-- 页面标题 -->
      <div class="mb-8">
        <PageTitle title={title} variant="stacked" />
      </div>

      <!-- Tab 分类导航（椭圆胶囊 + 换行） -->
      {enabledApisCount > 0 && categories.length > 1 && (
        <div class="tools-tab-wrapper">
          <div class="tools-tab-pill" data-tools-tab-nav>
            <div class="tools-tab-indicator" data-tools-tab-indicator></div>
            <button data-tools-tab="all" class="tools-tab-btn tools-tab-btn-active">
              全部
              <span class="tools-tab-badge">{enabledApisCount}</span>
            </button>
            {categories.map((cat) => (
              <button data-tools-tab={cat} class="tools-tab-btn tools-tab-btn-inactive">
                {cat}
                <span class="tools-tab-badge">{categoryCounts[cat]}</span>
              </button>
            ))}
          </div>
        </div>
      )}

      <!-- 工具卡片内容 -->
      {enabledApisCount > 0 ? (
        <div>
          <!-- 全部：按分类分组显示 -->
          <div data-tools-section="all">
            {enabledGroups.map((group) => {
              const cat = group.category;
              const catApis = group.items;
              return (
                <div class="tools-category-group mt-8 first:mt-0">
                  <div class="flex items-center gap-3 mb-5">
                    <div class="flex items-center gap-2">
                      <Icon name="material-symbols:label-outline" class="text-lg text-neutral-900 dark:text-neutral-100" />
                      <span class="text-base font-bold text-neutral-900 dark:text-neutral-100">{cat}</span>
                    </div>
                    <span class="text-xs text-neutral-400 dark:text-neutral-500">{catApis.length}</span>
                    <div class="flex-1 h-[2px] bg-black dark:bg-white" />
                  </div>
                  <div class="tools-card-grid">
                    {catApis.map((api, index) => (
                      <a
                        href={api.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="tools-card group"
                        data-category={cat}
                        style={`animation-delay: ${index * 60}ms`}
                      >
                        <div class="tools-card-jump-icon">
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M7 17L17 7" />
                            <path d="M7 7h10v10" />
                          </svg>
                        </div>
                        <div class="flex items-center gap-2 mb-3">
                          {api.icon ? (
                            api.icon.startsWith('http') ? (
                              <img src={api.icon} alt={api.name} loading="lazy" decoding="async" class="w-6 h-6 rounded object-contain shrink-0" />
                          ) : (
                              <Icon name={api.icon} class="text-2xl text-neutral-600 dark:text-neutral-300 group-hover:text-black dark:group-hover:text-white transition-colors duration-300 shrink-0" />
                            )
                          ) : (
                            <Icon name="material-symbols:api" class="text-2xl text-neutral-600 dark:text-neutral-300 group-hover:text-black dark:group-hover:text-white transition-colors duration-300 shrink-0" />
                          )}
                          <h3 class="text-lg font-bold text-neutral-900 dark:text-neutral-100 group-hover:translate-x-1 transition-transform duration-300 truncate">
                            {api.name}
                          </h3>
                        </div>
                        <p class="tools-card-desc">{api.description}</p>
                        <div class="tools-card-footer">
                          <span class="text-xs text-neutral-400 dark:text-neutral-500 truncate">
                            {new URL(api.url).hostname}
                          </span>
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>

          <!-- 各分类独立 Tab 内容 -->
          {enabledGroups.map((group) => {
            const cat = group.category;
            const catApis = group.items;
            return (
              <div data-tools-section={cat} class="hidden">
                <div class="tools-card-grid">
                  {catApis.map((api) => (
                    <a
                      href={api.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="tools-card group"
                      data-category={cat}
                    >
                      <div class="tools-card-jump-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M7 17L17 7" />
                          <path d="M7 7h10v10" />
                        </svg>
                      </div>
                      <div class="flex items-center gap-2 mb-3">
                        {api.icon ? (
                          api.icon.startsWith('http') ? (
                            <img data-src={api.icon} alt={api.name} loading="lazy" decoding="async" class="w-6 h-6 rounded object-contain shrink-0" />
                          ) : (
                            <Icon name={api.icon} class="text-2xl text-neutral-600 dark:text-neutral-300 group-hover:text-black dark:group-hover:text-white transition-colors duration-300 shrink-0" />
                          )
                        ) : (
                          <Icon name="material-symbols:api" class="text-2xl text-neutral-600 dark:text-neutral-300 group-hover:text-black dark:group-hover:text-white transition-colors duration-300 shrink-0" />
                        )}
                        <h3 class="text-lg font-bold text-neutral-900 dark:text-neutral-100 group-hover:translate-x-1 transition-transform duration-300 truncate">
                          {api.name}
                        </h3>
                      </div>
                      <p class="tools-card-desc">{api.description}</p>
                      <div class="tools-card-footer">
                        <span class="text-xs text-neutral-400 dark:text-neutral-500 truncate">
                          {new URL(api.url).hostname}
                        </span>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-16">
          <Icon name="material-symbols:bookmark-outline" class="text-5xl text-neutral-300 dark:text-neutral-600 mb-4" />
          <p class="text-neutral-500 dark:text-neutral-400">{i18n(I18nKey.collectionsEmpty)}</p>
        </div>
      )}
    </div>
  </div>


  <!-- 手风琴展开/收起：纯 CSS 高度过渡，JS 仅切换状态 -->
  <!-- 图标懒加载：收起的手风琴不请求 logo，首次展开时才把 data-src 换成 src -->
  <script is:inline>
    (function() {
      function activateIcons(accordion) {
        accordion.querySelectorAll("img[data-src]").forEach(function(img) {
          img.setAttribute("src", img.getAttribute("data-src"));
          img.removeAttribute("data-src");
        });
      }

      // 已展开的手风琴（默认第一组）：立即加载图标
      // 放在 ready 守卫之前，swup 切回本页（DOM 重建）时也能重新激活
      document.querySelectorAll("[data-tools-accordion][data-open]").forEach(activateIcons);

      if (window.__collectionsAccordionReady) return;
      window.__collectionsAccordionReady = true;

      document.addEventListener("click", function(e) {
        var header = e.target.closest(".tools-accordion-header");
        if (!header) return;
        var accordion = header.closest("[data-tools-accordion]");
        if (!accordion) return;
        var open = accordion.hasAttribute("data-open");
        if (open) {
          accordion.removeAttribute("data-open");
        } else {
          accordion.setAttribute("data-open", "");
          activateIcons(accordion);

        }
      }

      // 事件委托：tools tab 点击
      document.addEventListener("click", function(e) {
        var btn = e.target.closest("[data-tools-tab]");
        if (btn) activateTab(btn.dataset.toolsTab);
      });

      // hashchange
      window.addEventListener("hashchange", function() {
        var hash = window.location.hash.replace(/^#tools-/, "");
        if (hash) {
          try { hash = decodeURIComponent(hash); } catch(e) { return; }
          activateTab(hash);
        }
      });

      // resize
      window.addEventListener("resize", function() {
        var activeBtn = document.querySelector(".tools-tab-btn-active");
        if (activeBtn) updateIndicator(activeBtn);
      });

      // 初始化
      function init() {
        var hash = window.location.hash.replace(/^#tools-/, "");
        if (hash) {
          try { hash = decodeURIComponent(hash); } catch(e) { hash = ""; }
          if (hash) { activateTab(hash); return; }
        }
        var activeBtn = document.querySelector(".tools-tab-btn-active");
        if (activeBtn) {
          requestAnimationFrame(function() { updateIndicator(activeBtn); });
        }
      }

      init();
      document.addEventListener("astro:page-load", init);
    })();
  </script>
</MainGridLayout>
